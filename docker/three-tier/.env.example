# Local-only sandbox values. Change these before exposing anything outside localhost.
DEMO_POSTGRES_PASSWORD=replace-with-a-long-local-password
DEMO_GATEWAY_KEY=replace-with-a-random-32-character-secret
# Separate PostgREST LOGIN user (URL-safe, 32+ characters). Generated by `npm run docker:three-tier:init`.
DEMO_POSTGREST_PASSWORD=replace-with-a-random-url-safe-32-character-secret
