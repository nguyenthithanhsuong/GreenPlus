{
  "name": "greenplus",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "web-admin",
    "web-client",
    "web-shipper",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-with-docker.mjs",
    "dev:all": "concurrently -n SERVER,WARM \"turbo dev --ui=stream\" \"node scripts/prewarm-dev.mjs\"",
    "dev:turbo": "turbo dev --ui=tui",
    "dev:admin": "turbo dev --filter=web-admin",
    "dev:client": "turbo dev --filter=web-client",
    "dev:shipper": "turbo dev --filter=web-shipper",
    "build": "npm run build -w web-admin && npm run build -w web-client && npm run build -w web-shipper",
    "lint": "npm run lint -w web-admin && npm run lint -w web-client && npm run lint -w web-shipper",
    "lint-fix": "npm run lint-fix -w web-admin && npm run lint-fix -w web-client && npm run lint-fix -w web-shipper",
    "start": "turbo start",
    "typecheck": "npm run typecheck -w web-admin && npm run typecheck -w web-client && npm run typecheck -w web-shipper",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "rimraf .next .turbo out dist",
    "check-all": "npm run clean && npm run format && npm run lint-fix && npm run typecheck && npm run build",
    "mobile:client:init": "node scripts/mobile-twa.mjs client init",
    "mobile:shipper:init": "node scripts/mobile-twa.mjs shipper init",
    "mobile:client:build": "node scripts/mobile-twa.mjs client build",
    "mobile:shipper:build": "node scripts/mobile-twa.mjs shipper build",
    "test:shipper": "npm test -w web-shipper",
    "test:tenant-routing": "node --test tests/three-tier-routing.test.mjs tests/tenant-postgrest.test.mjs tests/tenant-registry.test.mjs tests/tenant-postgrest-adapter.test.mjs",
    "test:migrations": "node --test tests/migration-static.test.mjs",
    "test:three-tier-commerce": "node --test tests/three-tier-commerce-slice.test.mjs",
    "test:three-tier-commerce:docker": "node scripts/test-three-tier-commerce.mjs",
    "docker:three-tier:init": "node scripts/three-tier-docker.mjs init",
    "docker:three-tier:up": "node scripts/three-tier-docker.mjs up",
    "docker:three-tier:check": "node scripts/three-tier-docker.mjs check",
    "docker:three-tier:ps": "node scripts/three-tier-docker.mjs ps",
    "docker:three-tier:down": "node scripts/three-tier-docker.mjs down",
    "test:three-tier-transactions:docker": "node scripts/test-three-tier-transactions.mjs",
    "test:three-tier-lifecycle:docker": "node scripts/test-three-tier-lifecycle.mjs",
    "dev:web": "npm run dev:all"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "concurrently": "^10.0.6",
    "dotenv": "^16.6.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.7"
  },
  "dependencies": {
    "@logtail/next": "^0.3.1",
    "@logtail/node": "^0.5.8",
    "@supabase/supabase-js": "^2.102.1"
  },
  "overrides": {
    "next": "16.3.8"
  }
}
