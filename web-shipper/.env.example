# Web Shipper runs independently on port 3002. It does NOT call Web Admin or Web Client.
# Use the SAME Supabase database as the other GreenPlus applications.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
# Separate random secret for shipper cookies (minimum 32 bytes):
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SHIPPER_SESSION_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
# NEVER expose SUPABASE_SERVICE_ROLE_KEY / SHIPPER_SESSION_SECRET via NEXT_PUBLIC_ variables.
