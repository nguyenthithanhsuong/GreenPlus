{
  "name": "web-shipper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:turbo": "next dev --turbo -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "eslint",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "rimraf .next .turbo out dist",
    "check-all": "npm run clean && npm run format && npm run lint-fix && npm run typecheck && npm run build",
    "test:unit": "node --test tests/delivery-contract.test.mjs",
    "test:integration": "node --test tests/delivery-api.integration.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.1.6",
    "next-swagger-doc": "^0.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
